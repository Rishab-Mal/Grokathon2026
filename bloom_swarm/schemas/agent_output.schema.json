{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOutput",
  "description": "Output from a single agent for one week",
  "type": "object",
  "required": ["name", "p", "reason", "evidence"],
  "properties": {
    "name": {
      "type": "string",
      "enum": ["Weather", "Runoff", "Satellite", "Historian", "Skeptic"],
      "description": "Agent name"
    },
    "p": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.97,
      "description": "Probability of a harmful algal bloom"
    },
    "reason": {
      "type": "string",
      "description": "One sentence explanation"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of short supporting facts"
    }
  }
}
