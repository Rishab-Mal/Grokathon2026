{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InputWeek",
  "description": "Weekly input data for bloom prediction",
  "type": "object",
  "required": ["week", "weather", "runoff", "history", "actual"],
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date of the Monday starting the week"
    },
    "weather": {
      "type": "object",
      "required": ["max_temp_avg", "rain_total_mm", "hot_days"],
      "properties": {
        "max_temp_avg": { "type": "number", "description": "Average daily max temperature in Celsius" },
        "rain_total_mm": { "type": "number", "minimum": 0, "description": "Total rainfall in mm" },
        "hot_days": { "type": "integer", "minimum": 0, "maximum": 7, "description": "Days with max temp >= 30C" }
      }
    },
    "runoff": {
      "type": "object",
      "required": ["rain_last_14d_mm", "heavy_rain_days"],
      "properties": {
        "rain_last_14d_mm": { "type": "number", "minimum": 0, "description": "Rain in the past 14 days in mm" },
        "heavy_rain_days": { "type": "integer", "minimum": 0, "description": "Days with >10mm rain in past 14 days" }
      }
    },
    "satellite": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["cyano_index", "change_vs_last_week"],
          "properties": {
            "cyano_index": { "type": "number", "minimum": 0, "maximum": 1, "description": "Cyanobacteria index 0-1" },
            "change_vs_last_week": { "type": "number", "description": "Change in cyano_index from last week" }
          }
        }
      ]
    },
    "history": {
      "type": "object",
      "required": ["bloom_rate_this_month_past_years"],
      "properties": {
        "bloom_rate_this_month_past_years": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "actual": {
      "type": "integer",
      "enum": [0, 1],
      "description": "1 if a bloom occurred, 0 otherwise"
    }
  }
}
