{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalOutput",
  "description": "Aggregated swarm output for the frontend",
  "type": "object",
  "required": ["lake", "weeks", "scores"],
  "properties": {
    "lake": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "properties": {
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "agents", "swarm_p", "simple_avg_p", "base_rate_p", "actual"],
        "properties": {
          "week": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "p", "reason", "evidence", "weight"],
              "properties": {
                "name": { "type": "string" },
                "p": { "type": "number", "minimum": 0.03, "maximum": 0.97 },
                "reason": { "type": "string" },
                "evidence": { "type": "array", "items": { "type": "string" } },
                "weight": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "swarm_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "simple_avg_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "base_rate_p": { "type": "number", "minimum": 0, "maximum": 1 },
          "actual": { "type": "integer", "enum": [0, 1] }
        }
      }
    },
    "scores": {
      "type": "object",
      "required": ["Weather", "Runoff", "Satellite", "Historian", "Skeptic", "swarm", "simple_avg", "base_rate"],
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
